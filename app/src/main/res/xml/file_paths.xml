<?xml version="1.0" encoding="utf-8"?>
<paths>
    <cache-path
        name="backup"
        path="backup-and-restore/"/>
    <!-- Downloaded GIFs/stickers served to the target app via the Commit Content API. -->
    <cache-path
        name="gif_media"
        path="gif-media/"/>
    <!-- Converted/re-encoded stickers. In filesDir rather than the cache: re-encoding an animated
         sticker costs about a second, and a cache eviction would make the user pay it again. -->
    <files-path
        name="sticker_converted"
        path="sticker-converted/"/>
</paths>
